#:include src/widgets/base_screen.kv
#:import dp kivy.metrics.dp

<RegistrationScreen>:
    BaseScreen:
        MDBoxLayout:
            orientation: "vertical"
            padding: dp(24), dp(48), dp(24), dp(24)
            spacing: dp(24)

            MDLabel:
                text: "Регистрация"
                font_size: "28sp"
                halign: "center"
                theme_text_color: "Custom"
                text_color: 0, 0, 0, 1
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Заполните профиль, чтобы продолжить"
                font_size: "14sp"
                halign: "center"
                theme_text_color: "Custom"
                text_color: 0, 0, 0, 0.8
                size_hint_y: None
                height: self.texture_size[1]

            MDTextField:
                hint_text: "Имя"
                text: root.user_name
                on_text: root.user_name = self.text
                helper_text_mode: "on_error"
                max_text_length: 64
                disabled: root.is_saving

            MDTextField:
                hint_text: "Телефон"
                text: root.user_phone
                on_text: root.user_phone = self.text
                helper_text_mode: "on_error"
                max_text_length: 32
                disabled: root.is_saving

            MDLabel:
                text: root.error_text
                theme_text_color: "Custom"
                text_color: 1, 0, 0, 1
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1] if root.error_text else 0
                opacity: 1 if root.error_text else 0

            Widget:
                size_hint_y: 1

            MDBoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: dp(48)
                spacing: dp(12)

                MDRectangleFlatButton:
                    text: "Назад"
                    on_release: root.on_cancel()

                MDRaisedButton:
                    text: "Продолжить"
                    md_bg_color: 0, 0.6, 0.2, 1
                    text_color: 1, 1, 1, 1
                    disabled: root.is_saving
                    on_release: root.submit()

